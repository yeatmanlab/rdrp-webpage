{
  "hosting": [
    {
      "target": "rdrp",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "prototypes/**",
        "index.html",
        "NOTES.md",
        "README.md",
        "assets/people/original/**",
        "sitemap-bde.xml",
        "robots-bde.txt"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/",
          "destination": "/rdrp.html"
        },
        {
          "source": "/sitemap.xml",
          "destination": "/sitemap-rdrp.xml"
        },
        {
          "source": "/robots.txt",
          "destination": "/robots-rdrp.txt"
        }
      ]
    },
    {
      "target": "bde",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "prototypes/**",
        "index.html",
        "NOTES.md",
        "README.md",
        "assets/people/original/**",
        "sitemap-rdrp.xml",
        "robots-rdrp.txt"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/",
          "destination": "/bde.html"
        },
        {
          "source": "/sitemap.xml",
          "destination": "/sitemap-bde.xml"
        },
        {
          "source": "/robots.txt",
          "destination": "/robots-bde.txt"
        }
      ]
    }
  ]
}
