<?xml version="1.0" encoding="UTF-8"?>
<!--
  Served as /sitemap.xml on dyslexia.stanford.edu via a firebase.json rewrite.
  Lists ONLY dyslexia.stanford.edu URLs: a sitemap may not list URLs on another host
  unless both domains are verified in one Search Console account, so edneuro gets its
  own file (sitemap-bde.xml) rather than being listed here.
  These match each page's <link rel="canonical">. The two main pages canonicalize to
  their bare domain roots, so no internal acronym is ever public-facing.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://dyslexia.stanford.edu/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://dyslexia.stanford.edu/parents</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://dyslexia.stanford.edu/yeatman</loc>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>
</urlset>
