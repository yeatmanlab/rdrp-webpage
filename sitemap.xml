<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lists the canonical URL for each page, which spans two hosts: dyslexia.stanford.edu
  serves the reading and dyslexia pages, edneuro.stanford.edu serves the lab page.
  Both domains serve the whole repo, so every page is reachable from either one; the
  <link rel="canonical"> in each page picks the preferred host and this file agrees
  with it. The two main pages canonicalize to their bare domain roots rather than the
  /rdrp and /bde paths, so no internal acronym is ever public-facing — the lab
  switcher in each page already links to the other's bare domain for the same reason.
  A cross-host sitemap needs both domains verified under the same Search Console
  account to avoid a cross-submission warning.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://dyslexia.stanford.edu/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://edneuro.stanford.edu/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://dyslexia.stanford.edu/parents</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://dyslexia.stanford.edu/yeatman</loc>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>
</urlset>
